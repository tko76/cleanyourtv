<?xml version="1.0" encoding="utf-8"?>
<!--
  Power button icon: a white circle arc (gap at top) with a vertical stem — the universal power symbol —
  on a dark charcoal disc matching the launcher's background colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:viewportWidth="48"
    android:viewportHeight="48"
    android:width="48dp"
    android:height="48dp">

    <!-- Background disc -->
    <path
        android:fillColor="#0F1014"
        android:pathData="M24,24 m-24,0 a24,24 0,1,0 48,0 a24,24 0,1,0 -48,0" />

    <!-- Power arc: circle open at the top -->
    <path
        android:strokeColor="#E8E8F0"
        android:strokeWidth="2.8"
        android:fillColor="#00000000"
        android:pathData="M16.2,15.8 A10.5,10.5 0,1,0 31.8,15.8" />

    <!-- Power stem: vertical line from centre up through the gap -->
    <path
        android:strokeColor="#E8E8F0"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:pathData="M24,10.5 L24,21.5" />
</vector>
